{
  "name": "dsh-agy",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjjjose/dsh-agy.git"
  },
  "homepage": "https://github.com/jjjjose/dsh-agy#readme",
  "bugs": {
    "url": "https://github.com/jjjjose/dsh-agy/issues"
  },
  "description": "Google Antigravity (Cloud Code Assist) LLM Provider plugin for DeepSeek Harness. Sign in with your Google account and use Gemini / Claude / GPT-OSS from your Antigravity Coding Plan. Multi-platform (Windows, macOS, Linux).",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "llm-provider",
    "antigravity",
    "google-antigravity",
    "cloud-code-assist",
    "gemini",
    "claude",
    "gpt-oss",
    "oauth2",
    "subscription"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/INSTALL.md",
    "docs/ARCHITECTURE.md",
    "docs/VALIDATION.md",
    "docs/SELF_UPDATE.md",
    "docs/TUTORIAL.es.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run smoke && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
